# ╔══════════════════════════════════════════════════════════════╗
# ║              ZENITH AI WORKER (Railway)                     ║
# ║              Environment Configuration                      ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# On Railway: Set these in Settings → Variables

# ── Groq AI Key (REQUIRED) ──
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Server Port ──
# Railway auto-assigns this via $PORT, no need to change
PORT=3001

# ── Allowed Frontend Origins (comma-separated) ──
# Add your deployed frontend URLs here
# Example: https://roshhellwett.github.io,https://zenith.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,https://roshhellwett.github.io,https://zenithopensourceprojects.vercel.app
